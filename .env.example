# Copy to .env.local and fill in your values. Never commit .env.local.

OPENAI_API_KEY=

# Nebius AI (used by attacker for payload generation — OpenAI-compatible)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1/
NEBIUS_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
MONGODB_URI=
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
GITHUB_TOKEN=
GUAVA_API_KEY=
GUAVA_AGENT_NUMBER=
AKASH_API_KEY=
AKASHML_API_KEY=

# Attacker LLM provider — "openai" (default) or "akash"
# When "akash": uses AKASHML_API_KEY + https://api.akashml.com/v1 automatically.
# Override the model with ATTACKER_MODEL (default per provider: gpt-4o / meta-llama/Llama-3.3-70B-Instruct).
LLM_PROVIDER=openai
ATTACKER_MODEL=
ABUSEIPDB_KEY=

# Runtime
TWIN_URL=
SHIELD_PORT=4000
PHONE_ALERTS=false
ON_CALL_NUMBER=

# Dashboard
DEMO_MODE=true
DASHBOARD_UNLOCK=
SHIELD_URL=
ORCHESTRATOR_URL=
